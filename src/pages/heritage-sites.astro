---
import Base from '../layouts/Base.astro';
import Media from '../components/Media.astro';
import { routes } from '../routes';

const roles = [
  {
    who: 'Directors & curators',
    claim: 'Your story, told the way it deserves.',
    text: 'Emotion-first experiences built with your curators and validated by historians, so the reconstruction strengthens your scholarly reputation.',
  },
  {
    who: 'Finance & commercial',
    claim: 'Higher dwell time and ticket uplift, with zero cost at signing.',
    text: 'Grant-funded or amortised setup, a predictable licence, and a dashboard that shows how the experience performs.',
  },
  {
    who: 'Innovation & digital',
    claim: 'A flagship digital experience that puts your site ahead of its peers.',
    text: 'Spatially anchored mixed reality, a CMS your team controls, and a platform that keeps receiving updates.',
  },
];
---
<Base title="For heritage sites & museums · Visual History" active="heritage">
  <main id="main">
    <header class="page-intro">
      <div class="wrap audience-hero">
        <div class="stack" style="gap:24px">
          <h1 class="h1-audience">Make your history <em>unforgettable.</em></h1>
          <p class="lede">Bring back the visitors who stopped coming, and give new ones a reason to stay longer.</p>
          <a href={routes.contact} class="btn btn--primary">Book a vision meeting</a>
        </div>
        <Media ratio="4-3" slotId="heritage-hero" stripe={['#6b4a2a', '#4a321d']} />
      </div>
    </header>

    <section class="section--sub bg-raised" aria-labelledby="roles-h">
      <div class="wrap stack" style="gap:40px">
        <h2 id="roles-h" class="h2 h2--sub" style="max-width:760px">What it means for your team.</h2>
        <div class="roles">
          {roles.map((r) => (
            <div class="role">
              <div class="role-who">{r.who}</div>
              <div class="role-claim">{r.claim}</div>
              <p class="item-text">{r.text}</p>
            </div>
          ))}
        </div>
      </div>
    </section>

    <section class="section--sub">
      <div class="wrap proof">
        <div class="stack" style="gap:18px">
          <h2 class="h2 h2--sub">We're selecting our first flagship partner in Flanders.</h2>
          <p class="body-lg">Heritage sites, archaeological parks and museums are invited to shape the first full reconstruction with us.</p>
        </div>
        <div class="proof-slot">
          <div class="proof-k">FLAGSHIP PARTNER</div>
          <div class="proof-v">Your site here.</div>
          <a href={routes.contact} class="link-arrow" style="margin-top:12px">Start the conversation →</a>
        </div>
      </div>
    </section>
  </main>
</Base>

<style>
  .audience-hero {
    display: grid; grid-template-columns: repeat(auto-fit, minmax(min(100%, 440px), 1fr));
    gap: clamp(32px, 5vw, 72px); align-items: end;
  }
  .roles { display: flex; flex-direction: column; border-top: 1px solid var(--line); }
  .role {
    display: grid; grid-template-columns: repeat(auto-fit, minmax(min(100%, 260px), 1fr));
    gap: 12px clamp(24px, 4vw, 64px); padding: 36px 0; border-bottom: 1px solid var(--line);
  }
  .role-who { font: 500 17px/1.4 var(--sans); color: var(--text-5); }
  .role-claim { font: 500 clamp(24px, 2.4vw, 30px)/1.2 var(--sans); letter-spacing: -.025em; color: var(--text-1); text-wrap: pretty; }
  .proof {
    display: grid; grid-template-columns: repeat(auto-fit, minmax(min(100%, 440px), 1fr));
    gap: 32px; align-items: center;
  }
  .proof-slot {
    border: 1px dashed rgba(245, 165, 36, .6); border-radius: 8px; padding: 40px;
    display: flex; flex-direction: column; gap: 10px;
  }
  .proof-k { font: 500 12px/1 var(--mono); letter-spacing: .12em; color: var(--amber); }
  .proof-v { font: italic 500 34px/1.2 var(--sans); letter-spacing: -.03em; color: var(--text-1); }
</style>
